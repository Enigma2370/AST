<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

	<!-- Template for Graveyard list buttons -->
	<Button name="AST_GraveyardButtonTemplate" inherits="UIPanelButtonTemplate" virtual="true">
		<Size x="190" y="16" />
	</Button>

	<!-- Main addon window -->
	<Frame name="AST_MainFrame" parent="UIParent" movable="true" enableMouse="true" hidden="true" clampedToScreen="true" inherits="BasicFrameTemplate">
		<Size x="540" y="280" />
		<Anchors>
			<Anchor point="CENTER" />
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentTitle" inherits="GameFontNormal" text="Account Stat Tracker">
					<Anchors>
						<Anchor point="TOP" relativeTo="$parent" relativePoint="TOP" x="0" y="-4" />
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnMouseDown>
				if (button == "LeftButton") then self:StartMoving(); end
			</OnMouseDown>
			<OnMouseUp>
				if (button == "LeftButton") then self:StopMovingOrSizing(); end
			</OnMouseUp>
		</Scripts>
		<Frames>
			<!-- Tab buttons -->
			<CheckButton name="AST_Tab1" inherits="CharacterFrameTabButtonTemplate" id="1" text="Account">
				<Anchors><Anchor point="BOTTOMLEFT" x="15" y="2" /></Anchors>
				<Scripts><OnClick>AccountStatTracker:SelectTab(1)</OnClick></Scripts>
			</CheckButton>
			<CheckButton name="AST_Tab2" inherits="CharacterFrameTabButtonTemplate" id="2" text="Character">
				<Anchors><Anchor point="LEFT" relativeTo="AST_Tab1" relativePoint="RIGHT" x="-2" y="0" /></Anchors>
				<Scripts><OnClick>AccountStatTracker:SelectTab(2)</OnClick></Scripts>
			</CheckButton>
			<CheckButton name="AST_Tab3" inherits="CharacterFrameTabButtonTemplate" id="3" text="Graveyard">
				<Anchors><Anchor point="LEFT" relativeTo="AST_Tab2" relativePoint="RIGHT" x="-2" y="0" /></Anchors>
				<Scripts><OnClick>AccountStatTracker:SelectTab(3)</OnClick></Scripts>
			</CheckButton>
			<CheckButton name="AST_Tab4" inherits="CharacterFrameTabButtonTemplate" id="4" text="Session">
				<Anchors><Anchor point="LEFT" relativeTo="AST_Tab3" relativePoint="RIGHT" x="-2" y="0" /></Anchors>
				<Scripts><OnClick>AccountStatTracker:SelectTab(4)</OnClick></Scripts>
			</CheckButton>
			<CheckButton name="AST_Tab5" inherits="CharacterFrameTabButtonTemplate" id="5" text="Settings">
				<Anchors><Anchor point="LEFT" relativeTo="AST_Tab4" relativePoint="RIGHT" x="-2" y="0" /></Anchors>
				<Scripts><OnClick>AccountStatTracker:SelectTab(5)</OnClick></Scripts>
			</CheckButton>

			<!-- Panels -->
			<!-- Account-wide stats panel -->
			<Frame name="AST_Panel1" hidden="true">
				<Anchors><Anchor point="TOPLEFT" x="2" y="-18"/><Anchor point="BOTTOMRIGHT" x="-6" y="28"/></Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString inherits="GameFontNormalLarge" text="Account-Wide Totals">
							<Anchors><Anchor point="TOP" x="0" y="-20" /></Anchors>
						</FontString>
						<FontString inherits="GameFontNormal" text="Total XP Gained:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="40" y="-60"/></Anchors></FontString>
						<FontString name="AST_TotalXPValue" inherits="GameFontNormal" text="0" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="170" y="-60"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Total Deaths:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="270" y="-60"/></Anchors></FontString>
						<FontString name="AST_TotalDeathsValue" inherits="GameFontNormal" text="0" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="400" y="-60"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Total Quests:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="40" y="-90"/></Anchors></FontString>
						<FontString name="AST_TotalQuestsValue" inherits="GameFontNormal" text="0" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="170" y="-90"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Total Gold:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="270" y="-90"/></Anchors></FontString>
						<FontString name="AST_TotalMoneyValue" inherits="GameFontNormal" text="0" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="400" y="-90"/></Anchors></FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button name="AST_AccountFlexButton" inherits="UIPanelButtonTemplate" text="Flex">
						<Size x="100" y="22" />
						<Anchors><Anchor point="BOTTOM" x="0" y="20" /></Anchors>
						<Scripts><OnClick>AccountStatTracker:ToggleDropDownMenu(self, "ACCOUNT")</OnClick></Scripts>
					</Button>
				</Frames>
			</Frame>

			<!-- Current character stats panel -->
			<Frame name="AST_Panel2" hidden="true">
				<Anchors><Anchor point="TOPLEFT" x="2" y="-18"/><Anchor point="BOTTOMRIGHT" x="-6" y="28"/></Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="AST_CurrentCharTitle" inherits="GameFontNormalLarge" text="">
							<Anchors><Anchor point="TOP" x="0" y="-20" /></Anchors>
						</FontString>
						<FontString inherits="GameFontNormal" text="Race/Class:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="20" y="-60"/></Anchors></FontString>
						<FontString name="AST_Char_RaceClass" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="130" y="-60"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Level:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="20" y="-85"/></Anchors></FontString>
						<FontString name="AST_Char_Level" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="130" y="-85"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Status:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="20" y="-110"/></Anchors></FontString>
						<FontString name="AST_Char_Status" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="130" y="-110"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Location:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="20" y="-135"/></Anchors></FontString>
						<FontString name="AST_Char_Location" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="130" y="-135"/></Anchors></FontString>
						<FontString name="AST_Char_KilledByLabel" inherits="GameFontNormal" text="Killed by:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="20" y="-160"/></Anchors></FontString>
						<FontString name="AST_Char_KilledBy" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="130" y="-160"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="XP Gained:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="280" y="-60"/></Anchors></FontString>
						<FontString name="AST_Char_XP" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="400" y="-60"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Quests:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="280" y="-85"/></Anchors></FontString>
						<FontString name="AST_Char_Quests" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="400" y="-85"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Gold Gained:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="280" y="-110"/></Anchors></FontString>
						<FontString name="AST_Char_Money" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="400" y="-110"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Time Played:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="280" y="-135"/></Anchors></FontString>
						<FontString name="AST_Char_TimePlayed" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="400" y="-135"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Time This Level:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="280" y="-160"/></Anchors></FontString>
						<FontString name="AST_Char_TimeThisLevel" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="400" y="-160"/></Anchors></FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button name="AST_CharacterFlexButton" inherits="UIPanelButtonTemplate" text="Flex">
						<Size x="100" y="22" />
						<Anchors><Anchor point="BOTTOM" x="0" y="20" /></Anchors>
						<Scripts><OnClick>AccountStatTracker:ToggleDropDownMenu(self, "CHARACTER")</OnClick></Scripts>
					</Button>
				</Frames>
			</Frame>

			<!-- Graveyard panel -->
			<Frame name="AST_Panel3" hidden="true">
				<Anchors><Anchor point="TOPLEFT" x="2" y="-18"/><Anchor point="BOTTOMRIGHT" x="-6" y="28"/></Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<FontString name="$parentTitle" inherits="GameFontNormalLarge" text="Hall of Fallen Heroes">
							<Anchors><Anchor point="TOP" x="0" y="-15"/></Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<ScrollFrame name="AST_GraveyardListScrollFrame" inherits="FauxScrollFrameTemplate">
						<Size x="200" y="180"/>
						<Anchors><Anchor point="TOPLEFT" x="15" y="-40"/></Anchors>
						<Frames>
							<Button name="AST_GraveyardListScrollFrameButton1" inherits="AST_GraveyardButtonTemplate"><Anchors><Anchor point="TOPLEFT" x="1" y="-1" /></Anchors></Button>
							<Button name="AST_GraveyardListScrollFrameButton2" inherits="AST_GraveyardButtonTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentButton1" relativePoint="BOTTOMLEFT" /></Anchors></Button>
							<Button name="AST_GraveyardListScrollFrameButton3" inherits="AST_GraveyardButtonTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentButton2" relativePoint="BOTTOMLEFT" /></Anchors></Button>
							<Button name="AST_GraveyardListScrollFrameButton4" inherits="AST_GraveyardButtonTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentButton3" relativePoint="BOTTOMLEFT" /></Anchors></Button>
							<Button name="AST_GraveyardListScrollFrameButton5" inherits="AST_GraveyardButtonTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentButton4" relativePoint="BOTTOMLEFT" /></Anchors></Button>
							<Button name="AST_GraveyardListScrollFrameButton6" inherits="AST_GraveyardButtonTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentButton5" relativePoint="BOTTOMLEFT" /></Anchors></Button>
							<Button name="AST_GraveyardListScrollFrameButton7" inherits="AST_GraveyardButtonTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentButton6" relativePoint="BOTTOMLEFT" /></Anchors></Button>
							<Button name="AST_GraveyardListScrollFrameButton8" inherits="AST_GraveyardButtonTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentButton7" relativePoint="BOTTOMLEFT" /></Anchors></Button>
							<Button name="AST_GraveyardListScrollFrameButton9" inherits="AST_GraveyardButtonTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentButton8" relativePoint="BOTTOMLEFT" /></Anchors></Button>
							<Button name="AST_GraveyardListScrollFrameButton10" inherits="AST_GraveyardButtonTemplate"><Anchors><Anchor point="TOPLEFT" relativeTo="$parentButton9" relativePoint="BOTTOMLEFT" /></Anchors></Button>
						</Frames>
						<Scripts>
							<OnVerticalScroll>
								FauxScrollFrame_OnVerticalScroll(self, offset, 16, AccountStatTracker.UpdateGraveyardPanel);
							</OnVerticalScroll>
						</Scripts>
					</ScrollFrame>

					<Frame name="AST_GraveyardDetailFrame" hidden="true">
						<Size x="280" y="180"/>
						<Anchors><Anchor point="TOPRIGHT" x="-15" y="-40"/></Anchors>
						<Layers>
							<Layer level="ARTWORK">
								<FontString name="AST_Grave_Name" inherits="GameFontNormalLarge" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="10" y="0"/></Anchors></FontString>
								<FontString name="AST_Grave_Details" inherits="GameFontNormalSmall" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" relativeTo="AST_Grave_Name" relativePoint="BOTTOMLEFT" x="0" y="-2"/></Anchors></FontString>
								<FontString inherits="GameFontNormal" text="Killed By:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="10" y="-45"/></Anchors></FontString>
								<FontString name="AST_Grave_KilledBy" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="110" y="-45"/></Anchors></FontString>
								<FontString inherits="GameFontNormal" text="Location:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="10" y="-65"/></Anchors></FontString>
								<FontString name="AST_Grave_Location" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="110" y="-65"/></Anchors></FontString>
								<FontString inherits="GameFontNormal" text="Time Played:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="10" y="-85"/></Anchors></FontString>
								<FontString name="AST_Grave_TimePlayed" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="110" y="-85"/></Anchors></FontString>
								<FontString inherits="GameFontNormal" text="XP Gained:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="10" y="-125"/></Anchors></FontString>
								<FontString name="AST_Grave_XP" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="110" y="-125"/></Anchors></FontString>
								<FontString inherits="GameFontNormal" text="Quests:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="10" y="-145"/></Anchors></FontString>
								<FontString name="AST_Grave_Quests" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="110" y="-145"/></Anchors></FontString>
								<FontString inherits="GameFontNormal" text="Gold Gained:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="10" y="-165"/></Anchors></FontString>
								<FontString name="AST_Grave_Money" inherits="GameFontNormal" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="110" y="-165"/></Anchors></FontString>
							</Layer>
						</Layers>
					</Frame>
				</Frames>
			</Frame>

			<!-- Session panel -->
			<Frame name="AST_Panel4" hidden="true">
				<Anchors><Anchor point="TOPLEFT" x="2" y="-18"/><Anchor point="BOTTOMRIGHT" x="-6" y="28"/></Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString inherits="GameFontNormalLarge" text="Current Session Stats">
							<Anchors><Anchor point="TOP" x="0" y="-20" /></Anchors>
						</FontString>
						<FontString inherits="GameFontNormal" text="XP Gained:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="40" y="-60"/></Anchors></FontString>
						<FontString name="AST_SessionXPValue" inherits="GameFontNormal" text="0" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="170" y="-60"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="XP / Hour:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="270" y="-60"/></Anchors></FontString>
						<FontString name="AST_SessionXPHourValue" inherits="GameFontNormal" text="0" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="400" y="-60"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Quests:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="40" y="-90"/></Anchors></FontString>
						<FontString name="AST_SessionQuestsValue" inherits="GameFontNormal" text="0" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="170" y="-90"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Gold Gained:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="270" y="-90"/></Anchors></FontString>
						<FontString name="AST_SessionMoneyValue" inherits="GameFontNormal" text="0" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="400" y="-90"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Time Played:" justifyH="RIGHT"><Anchors><Anchor point="TOPLEFT" x="40" y="-120"/></Anchors></FontString>
						<FontString name="AST_SessionTimePlayedValue" inherits="GameFontNormal" text="0m" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="170" y="-120"/></Anchors></FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button name="AST_SessionResetButton" inherits="UIPanelButtonTemplate" text="Reset Session">
						<Size x="120" y="22" />
						<Anchors><Anchor point="BOTTOM" x="0" y="20" /></Anchors>
						<Scripts><OnClick>AccountStatTracker:ResetSession()</OnClick></Scripts>
					</Button>
				</Frames>
			</Frame>

			<!-- Settings panel -->
			<Frame name="AST_Panel5" hidden="true">
				<Anchors><Anchor point="TOPLEFT" x="2" y="-18"/><Anchor point="BOTTOMRIGHT" x="-6" y="28"/></Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString inherits="GameFontNormalLarge" text="Settings">
							<Anchors><Anchor point="TOP" x="0" y="-20" /></Anchors>
						</FontString>
						<FontString inherits="GameFontNormal" text="Reset Current Character:" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="40" y="-60"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Reset Graveyard:" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="40" y="-90"/></Anchors></FontString>
						<FontString inherits="GameFontNormal" text="Reset ALL Data:" justifyH="LEFT"><Anchors><Anchor point="TOPLEFT" x="40" y="-120"/></Anchors></FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button inherits="UIPanelButtonTemplate" text="Reset">
						<Size x="100" y="22" />
						<Anchors><Anchor point="TOPRIGHT" x="-40" y="-55" /></Anchors>
						<Scripts><OnClick>AccountStatTracker:ShowConfirmation("Are you sure you want to reset this character?", AccountStatTracker.ResetCharacter)</OnClick></Scripts>
					</Button>
					<Button inherits="UIPanelButtonTemplate" text="Reset">
						<Size x="100" y="22" />
						<Anchors><Anchor point="TOPRIGHT" x="-40" y="-85" /></Anchors>
						<Scripts><OnClick>AccountStatTracker:ShowConfirmation("Are you sure you want to clear the Graveyard?", AccountStatTracker.ResetGraveyard)</OnClick></Scripts>
					</Button>
					<Button inherits="UIPanelButtonTemplate" text="Reset All">
						<Size x="100" y="22" />
						<Anchors><Anchor point="TOPRIGHT" x="-40" y="-115" /></Anchors>
						<Scripts><OnClick>AccountStatTracker:ShowConfirmation("WARNING: This will delete ALL data for the addon. Are you sure?", AccountStatTracker.ResetAll)</OnClick></Scripts>
					</Button>
				</Frames>
			</Frame>
		</Frames>
	</Frame>

	<!-- Dropdown menu for the "Flex" feature -->
	<Frame name="AST_DropDownMenu" inherits="UIDropDownMenuTemplate" id="1" />

	<!-- Confirmation Popup -->
	<Frame name="AST_ConfirmationFrame" parent="UIParent" frameStrata="DIALOG" hidden="true" inherits="BasicFrameTemplate">
		<Size x="300" y="120" />
		<Anchors><Anchor point="CENTER" /></Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" inherits="GameFontNormal" text="Are you sure?">
					<Anchors><Anchor point="TOP" x="0" y="-20" /></Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentYes" inherits="UIPanelButtonTemplate" text="Yes">
				<Size x="80" y="22" />
				<Anchors><Anchor point="BOTTOMLEFT" x="50" y="20" /></Anchors>
				<Scripts><OnClick>AccountStatTracker:ConfirmAction()</OnClick></Scripts>
			</Button>
			<Button name="$parentNo" inherits="UIPanelButtonTemplate" text="No">
				<Size x="80" y="22" />
				<Anchors><Anchor point="BOTTOMRIGHT" x="-50" y="20" /></Anchors>
				<Scripts><OnClick>self:GetParent():Hide()</OnClick></Scripts>
			</Button>
		</Frames>
	</Frame>
</Ui>
